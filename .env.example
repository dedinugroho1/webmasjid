# ── Database (Neon Postgres) ───────────────────────────────────────────
# Connection string "pooled" dari dashboard Neon (host berakhiran -pooler).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/webmasjid?sslmode=require"
# Opsional: koneksi langsung (non-pooled) untuk drizzle-kit migrate.
DATABASE_URL_UNPOOLED=""
# "neon" (default) atau "pg" untuk Postgres biasa (VPS/Docker/lokal).
DATABASE_DRIVER="neon"

# ── Better Auth ────────────────────────────────────────────────────────
# Buat secret acak: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Di Vercel boleh dikosongkan: URL produksi/preview terdeteksi otomatis.
BETTER_AUTH_URL="http://localhost:3000"

# ── Aplikasi ───────────────────────────────────────────────────────────
# Di Vercel boleh dikosongkan (lihat BETTER_AUTH_URL). Isi bila memakai domain sendiri.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Isi "true" agar build Vercel mengisi masjid demo /al-ikhlas (sekali, bila belum ada).
SEED_DEMO="false"
NEXT_PUBLIC_APP_NAME="WebMasjid"
NEXT_PUBLIC_GITHUB_URL="https://github.com/dedinugroho1/webmasjid"
# Set "false" untuk menutup pendaftaran masjid baru (mis. self-host 1 masjid).
NEXT_PUBLIC_ALLOW_REGISTRATION="true"

# Kanal infaq platform (biaya server & pemeliharaan). Kosongkan untuk menyembunyikan.
NEXT_PUBLIC_PLATFORM_QRIS_URL=""
NEXT_PUBLIC_PLATFORM_DONATION_NOTE="Infaq untuk biaya server & pemeliharaan WebMasjid"
# Nomor WhatsApp layanan "Terima Beres" (format internasional tanpa +).
NEXT_PUBLIC_SERVICE_WHATSAPP=""

# ── Penyimpanan file (opsional) ────────────────────────────────────────
# Jika diisi, upload logo/QRIS/bukti disimpan di Vercel Blob.
# Jika kosong, gambar kecil (<= 300 KB) disimpan sebagai data URL di database.
BLOB_READ_WRITE_TOKEN=""

# ── Email (opsional) ───────────────────────────────────────────────────
# Untuk email lupa password via Resend (https://resend.com). Jika kosong,
# admin DKM dapat membuat password sementara dari menu Pengurus.
RESEND_API_KEY=""
EMAIL_FROM="WebMasjid <noreply@domain-anda.com>"

# ── Keamanan ───────────────────────────────────────────────────────────
# Batas percobaan login/daftar/reset password aktif secara default.
# Set "true" hanya untuk pengujian otomatis.
RATE_LIMIT_DISABLED="false"

# ── Domain sendiri per masjid ──────────────────────────────────────────
# Host tambahan milik platform (dipisah koma), mis. "webmasjid.com,www.webmasjid.com".
PLATFORM_HOSTS=""
# Target CNAME yang ditampilkan ke pengurus (default: host NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_CUSTOM_DOMAIN_TARGET=""
