# ── Database (Neon Postgres) ───────────────────────────────────────────
# Connection string "pooled" dari dashboard Neon (host berakhiran -pooler).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/webmasjid?sslmode=require"
# Opsional: koneksi langsung (non-pooled) untuk drizzle-kit migrate.
DATABASE_URL_UNPOOLED=""
# Driver: "pg" (default, node-postgres — direkomendasikan Neon untuk Vercel) atau
# "neon" (@neondatabase/serverless via WebSocket, untuk runtime serverless/edge lain).
DATABASE_DRIVER="pg"

# ── Better Auth ────────────────────────────────────────────────────────
# Buat secret acak: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Di Vercel boleh dikosongkan: URL produksi/preview terdeteksi otomatis.
BETTER_AUTH_URL="http://localhost:3000"

# ── Aplikasi ───────────────────────────────────────────────────────────
# Di Vercel boleh dikosongkan (lihat BETTER_AUTH_URL). Isi bila memakai domain sendiri.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Isi "true" agar build Vercel mengisi masjid demo /al-ikhlas (sekali, bila belum ada).
SEED_DEMO="false"
NEXT_PUBLIC_APP_NAME="WebMasjid"
NEXT_PUBLIC_GITHUB_URL="https://github.com/dedinugroho1/webmasjid"
# Set "false" untuk menutup pendaftaran masjid baru (mis. self-host 1 masjid).
# Ini hanya nilai awal: tombol "Pendaftaran masjid dibuka" di panel /superadmin menimpanya.
NEXT_PUBLIC_ALLOW_REGISTRATION="true"

# Kanal infaq platform (biaya server & pemeliharaan). Kosongkan untuk menyembunyikan.
NEXT_PUBLIC_PLATFORM_QRIS_URL=""
NEXT_PUBLIC_PLATFORM_DONATION_NOTE="Infaq untuk biaya server & pemeliharaan WebMasjid"
# Nomor WhatsApp layanan "Terima Beres" (format internasional tanpa +).
# Kosong + NEXT_PUBLIC_CONTACT_EMAIL kosong = bagian "Jasa Pasang" disembunyikan di landing page.
NEXT_PUBLIC_SERVICE_WHATSAPP=""
# Email kontak publik (halaman Privasi/Syarat & tombol layanan bila WhatsApp kosong).
NEXT_PUBLIC_CONTACT_EMAIL=""
# Nama pengelola layanan yang tampil di Kebijakan Privasi & Syarat Ketentuan.
NEXT_PUBLIC_OPERATOR_NAME=""

# ── Penyimpanan file (opsional) ────────────────────────────────────────
# Jika keempat variabel Bunny diisi, logo/QRIS/foto/bukti disimpan di Bunny Storage
# (maks 4 MB per gambar, disajikan lewat CDN). Jika kosong, gambar kecil
# (<= 300 KB) disimpan sebagai data URL di database.
BUNNY_STORAGE_ZONE=""        # nama Storage Zone
BUNNY_STORAGE_PASSWORD=""    # Storage Zone → FTP & API Access → Password (bukan API key akun)
BUNNY_STORAGE_REGION=""      # kosong = Falkenstein (DE); sg = Singapura, ny, la, syd, uk, se, br, jh
BUNNY_CDN_URL=""             # URL Pull Zone yang terhubung ke zone, mis. https://masjid.b-cdn.net

# ── Email (opsional) ───────────────────────────────────────────────────
# Email lupa password & notifikasi via Mailketing (https://mailketing.co.id).
# Token: Mailketing → Pengaturan → API Email. Domain pengirim pada EMAIL_FROM
# harus sudah ditambahkan & aktif di Mailketing → Pengaturan → Sender & Domain.
# Jika kosong, admin DKM dapat membuat password sementara dari menu Pengurus.
MAILKETING_API_TOKEN=""
EMAIL_FROM="WebMasjid <noreply@domain-anda.com>"
# Email pengelola platform (boleh beberapa, dipisah koma) yang dikabari setiap
# ada masjid baru mendaftar. Butuh MAILKETING_API_TOKEN & EMAIL_FROM di atas.
ADMIN_NOTIFY_EMAIL=""

# ── Keamanan ───────────────────────────────────────────────────────────
# Batas percobaan login/daftar/reset password aktif secara default.
# Set "true" hanya untuk pengujian otomatis.
RATE_LIMIT_DISABLED="false"

# ── Domain sendiri per masjid ──────────────────────────────────────────
# Host tambahan milik platform (dipisah koma), mis. "webmasjid.com,www.webmasjid.com".
PLATFORM_HOSTS=""
# Target CNAME yang ditampilkan ke pengurus (default: host NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_CUSTOM_DOMAIN_TARGET=""
